# PostgreSQL / Neon Database connection string
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google OAuth 2.0 Credentials (with scope: https://www.googleapis.com/auth/postmaster.readonly)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# Application Base URL (e.g., https://your-domain.vercel.app or http://localhost:3000)
APP_URL="http://localhost:3000"

# Session encryption secret (Random 32+ character string)
NEXTAUTH_SECRET="super-secret-random-jwt-key-change-in-production-min-32-chars"

# Automated Cron Sync Security Key (Passed via Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="cron-sync-secret-auth-key-12345"

# Gemini API Key (optional for deliverability analysis)
GEMINI_API_KEY=""
